#!/bin/sh

echo "🔍 [pre-commit] Running code quality checks..."

# 1. Laravel Pint (staged PHP files only — don't touch unrelated unstaged work)
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)
if [ -n "$STAGED_PHP" ]; then
  echo "→ Pint (code style on staged PHP)..."
  echo "$STAGED_PHP" | xargs ./vendor/bin/pint
  if [ $? -ne 0 ]; then
    echo "❌ Pint failed. Fix errors and re-stage files."
    exit 1
  fi
  # Re-stage only the files Pint may have rewritten
  echo "$STAGED_PHP" | xargs git add
else
  echo "→ Pint skipped (no staged PHP files)."
fi

# 2. Gitleaks (secret scan, staged only)
echo "→ gitleaks (secret scan)..."
GITLEAKS_BIN=$(which gitleaks 2>/dev/null || echo "$HOME/.local/bin/gitleaks")
if [ -f "$GITLEAKS_BIN" ]; then
  "$GITLEAKS_BIN" protect --staged --no-banner --redact
  if [ $? -ne 0 ]; then
    echo "❌ gitleaks found potential secrets! Remove them before committing."
    exit 1
  fi
else
  echo "⚠️  gitleaks not found — skipping secret scan (install from https://github.com/gitleaks/gitleaks)"
fi

echo "✅ [pre-commit] All checks passed."
