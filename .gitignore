Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log

# =============================================================================
# Environment / secrets (CRITICAL)
# =============================================================================
.env
.env.backup
.env.production
.env.local
.env.*.local
!.env.example
!.env.testing.example

# API keys / credentials
*.pem
*.key
*.cert
*.crt
secrets/
credentials/

